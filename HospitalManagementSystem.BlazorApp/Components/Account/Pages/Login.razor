@page "/Account/Login"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.ComponentModel.DataAnnotations
@using HospitalManagementSystem.BlazorApp.Services
@using HospitalManagementSystem.Core.Application.Interfaces
@inject IJwtTokenService JwtTokenService
@inject CustomJwtAuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Secure Login - AegisCare HMS</PageTitle>

<div class="d-flex align-items-center justify-content-center" style="min-height: 80vh;">
    <MudCard Elevation="1" Class="rounded-2xl pa-6 pa-md-8" Style="max-width: 440px; width: 100%;">
        <div class="text-center mb-6">
            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large" Class="mx-auto mb-3" Style="width: 56px; height: 56px;">
                <MudIcon Icon="@Icons.Material.Filled.LocalHospital" Size="Size.Medium" />
            </MudAvatar>
            <MudText Typo="Typo.h5" Class="fw-bold text-dark">AegisCare Login</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Sign in to your hospital workspace</MudText>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="rounded-lg mb-4" Dense="true">
                @errorMessage
            </MudAlert>
        }

        <EditForm Model="inputModel" OnValidSubmit="HandleLogin" FormName="loginForm">
            <DataAnnotationsValidator />

            <MudTextField @bind-Value="inputModel.Email" Label="Work Email Address" Variant="Variant.Outlined"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Email"
                          Required="true" Margin="Margin.Dense" Class="mb-4" Placeholder="e.g. doctor@hospital.com" />

            <MudTextField @bind-Value="inputModel.Password" Label="Password" Variant="Variant.Outlined"
                          InputType="InputType.Password" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Lock"
                          Required="true" Margin="Margin.Dense" Class="mb-6" Placeholder="••••••••" />

            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                       FullWidth="true" Size="Size.Large" Class="py-3" Disabled="@isLoading"
                       StartIcon="@Icons.Material.Filled.Login">
                @if (isLoading)
                {
                    <MudProgressCircular Color="Color.Inherit" Size="Size.Small" Indeterminate="true" Class="me-2" />
                    <span>Signing in...</span>
                }
                else
                {
                    <span>Sign In</span>
                }
            </MudButton>
        </EditForm>
    </MudCard>
</div>

@code {
    private LoginInputModel inputModel = new();
    private string? errorMessage;
    private bool isLoading = false;

    private async Task HandleLogin()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var token = await JwtTokenService.GenerateTokenAsync(inputModel.Email, inputModel.Password);
            if (string.IsNullOrEmpty(token))
            {
                errorMessage = "Invalid email or password. Please check your credentials.";
            }
            else
            {
                await AuthStateProvider.MarkUserAsAuthenticatedAsync(token);
                Snackbar.Add("Logged in successfully!", Severity.Success);
                NavigationManager.NavigateTo("/");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred during sign-in: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    public class LoginInputModel
    {
        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "Please enter a valid email address.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required.")]
        public string Password { get; set; } = string.Empty;
    }
}
