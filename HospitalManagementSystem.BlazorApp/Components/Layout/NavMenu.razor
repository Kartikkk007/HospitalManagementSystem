@using HospitalManagementSystem.BlazorApp.Services
@inject NavigationManager NavigationManager
@inject CustomJwtAuthenticationStateProvider AuthStateProvider

<MudNavMenu Class="pa-2" Color="Color.Primary" Rounded="true" Margin="Margin.Dense">
    <!-- OVERVIEW -->
    <MudText Typo="Typo.overline" Class="px-3 text-slate-400 mt-2 mb-1" Style="font-size: 0.75rem; letter-spacing: 0.05em;">OVERVIEW</MudText>
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard" IconColor="Color.Primary">
        Dashboard Home
    </MudNavLink>

    <!-- CLINICAL & WARDS -->
    <AuthorizeView Roles="Admin,Doctor,Nurse,Receptionist">
        <Authorized>
            <MudText Typo="Typo.overline" Class="px-3 text-slate-400 mt-4 mb-1" Style="font-size: 0.75rem; letter-spacing: 0.05em;">CLINICAL & WARDS</MudText>
            
            <AuthorizeView Roles="Admin,Nurse,Doctor" Context="wardContext">
                <Authorized>
                    <MudNavLink Href="wards/beds" Icon="@Icons.Material.Filled.SingleBed" IconColor="Color.Info">
                        IPD Bed Map
                    </MudNavLink>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Roles="Admin,Receptionist" Context="opdContext">
                <Authorized>
                    <MudNavLink Href="appointments/book" Icon="@Icons.Material.Filled.CalendarMonth" IconColor="Color.Success">
                        Book OPD Slot
                    </MudNavLink>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Roles="Admin,Doctor" Context="docContext">
                <Authorized>
                    <MudNavLink Href="doctor/consultation" Icon="@Icons.Material.Filled.MedicalServices" IconColor="Color.Warning">
                        Doctor Portal
                    </MudNavLink>
                </Authorized>
            </AuthorizeView>

            <!-- PATIENT MANAGEMENT -->
            <MudText Typo="Typo.overline" Class="px-3 text-slate-400 mt-4 mb-1" Style="font-size: 0.75rem; letter-spacing: 0.05em;">PATIENTS</MudText>

            <MudNavLink Href="patients/registry" Icon="@Icons.Material.Filled.PeopleAlt" IconColor="Color.Primary">
                Master Registry
            </MudNavLink>

            <AuthorizeView Roles="Admin,Nurse,Receptionist" Context="intakeContext">
                <Authorized>
                    <MudNavLink Href="patients/register" Icon="@Icons.Material.Filled.PersonAddAlt1" IconColor="Color.Secondary">
                        Patient Intake
                    </MudNavLink>
                </Authorized>
            </AuthorizeView>
        </Authorized>
    </AuthorizeView>

    <!-- ADMIN UTILITIES -->
    <AuthorizeView Roles="Admin">
        <Authorized>
            <MudText Typo="Typo.overline" Class="px-3 text-slate-400 mt-4 mb-1" Style="font-size: 0.75rem; letter-spacing: 0.05em;">ADMINISTRATION</MudText>
            <MudNavLink Href="counter" Icon="@Icons.Material.Filled.Analytics" IconColor="Color.Inherit">
                Metrics Counter
            </MudNavLink>
            <MudNavLink Href="weather" Icon="@Icons.Material.Filled.Thermostat" IconColor="Color.Inherit">
                Facility Climate
            </MudNavLink>
        </Authorized>
    </AuthorizeView>

    <!-- ACCOUNT -->
    <MudText Typo="Typo.overline" Class="px-3 text-slate-400 mt-4 mb-1" Style="font-size: 0.75rem; letter-spacing: 0.05em;">SESSION</MudText>
    <AuthorizeView>
        <Authorized>
            <MudNavLink OnClick="HandleSignOut" Icon="@Icons.Material.Filled.Logout" IconColor="Color.Error">
                Sign Out
            </MudNavLink>
        </Authorized>
        <NotAuthorized>
            <MudNavLink Href="Account/Login" Icon="@Icons.Material.Filled.Login" IconColor="Color.Primary">
                Sign In
            </MudNavLink>
            <MudNavLink Href="Account/Register" Icon="@Icons.Material.Filled.AppRegistration" IconColor="Color.Secondary">
                Register
            </MudNavLink>
        </NotAuthorized>
    </AuthorizeView>
</MudNavMenu>

@code {
    private async Task HandleSignOut()
    {
        await AuthStateProvider.MarkUserAsLoggedOutAsync();
        NavigationManager.NavigateTo("/Account/Login");
    }
}
