@page "/wards/beds"
@attribute [Authorize(Roles = "Admin,Nurse,Doctor")]
@using HospitalManagementSystem.BlazorApp.Components.Pages.Wards
@using HospitalManagementSystem.Core.Domain.Entities
@using HospitalManagementSystem.Core.Application.Interfaces
@inject IAdmissionService AdmissionService
@inject IPatientService PatientService
@inject ISnackbar Snackbar

<PageTitle>IPD Ward & Bed Allocation Map - AegisCare HMS</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-2">
    <!-- Header Banner -->
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
        <div>
            <MudText Typo="Typo.h4" Class="fw-bold text-dark">IPD Ward & Bed Map</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Real-time bed occupancy telemetry and intake management across hospital wards.</MudText>
        </div>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadDataAsync">
            Refresh Status
        </MudButton>
    </MudStack>

    <!-- Stat Metric Cards -->
    <MudGrid Spacing="3" Class="mb-4">
        <MudItem xs="12" sm="4">
            <MudCard Elevation="1" Class="rounded-xl pa-3">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="fw-bold">TOTAL REGISTERED BEDS</MudText>
                        <MudText Typo="Typo.h4" Class="fw-bold">@(beds?.Count ?? 0)</MudText>
                    </div>
                    <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large">
                        <MudIcon Icon="@Icons.Material.Filled.Grid3x3" />
                    </MudAvatar>
                </MudStack>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudCard Elevation="1" Class="rounded-xl pa-3">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="fw-bold">AVAILABLE FOR INTAKE</MudText>
                        <MudText Typo="Typo.h4" Color="Color.Success" Class="fw-bold">@(beds?.Count(b => !b.IsOccupied) ?? 0)</MudText>
                    </div>
                    <MudAvatar Color="Color.Success" Variant="Variant.Filled" Size="Size.Large">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" />
                    </MudAvatar>
                </MudStack>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudCard Elevation="1" Class="rounded-xl pa-3">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="fw-bold">CURRENTLY OCCUPIED</MudText>
                        <MudText Typo="Typo.h4" Color="Color.Error" Class="fw-bold">@(beds?.Count(b => b.IsOccupied) ?? 0)</MudText>
                    </div>
                    <MudAvatar Color="Color.Error" Variant="Variant.Filled" Size="Size.Large">
                        <MudIcon Icon="@Icons.Material.Filled.Hotel" />
                    </MudAvatar>
                </MudStack>
            </MudCard>
        </MudItem>
    </MudGrid>

    @if (isLoading)
    {
        <div class="text-center py-8">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            <MudText Typo="Typo.body2" Class="mt-2 text-muted">Synchronizing live bed telemetry...</MudText>
        </div>
    }
    else
    {
        <BedGrid Beds="beds" 
                 OnAllocateClicked="HandleOpenAllocateModal" 
                 OnDischargeClicked="HandleDischargeAsync" />
    }
</MudContainer>

<!-- Allocation Modal Dialog -->
<MudDialog @bind-Visible="showAllocateModal" Options="dialogOptions">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.MeetingRoom" Color="Color.Primary" />
            <MudText Typo="Typo.h6" Class="fw-bold">Allocate Bed @selectedBed?.BedNumber</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            Ward: <strong>@selectedBed?.WardName</strong> | Daily Rate: <strong>₹@selectedBed?.DailyRate/day</strong>
        </MudText>

        <MudSelect T="Guid" @bind-Value="selectedPatientId" Label="Select Unassigned Outpatient" Variant="Variant.Outlined"
                   Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter" Class="mb-3">
            <MudSelectItem Value="@Guid.Empty">-- Choose Registered Patient --</MudSelectItem>
            @if (availablePatients != null)
            {
                @foreach (var patient in availablePatients)
                {
                    <MudSelectItem Value="@patient.Id">@patient.FirstName @patient.LastName (Phone: @patient.PhoneNumber)</MudSelectItem>
                }
            }
        </MudSelect>
        <MudText Typo="Typo.caption" Color="Color.Secondary">Only unadmitted outpatients are listed.</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseModal" Variant="Variant.Outlined">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(selectedPatientId == Guid.Empty)" OnClick="ConfirmAllocationAsync">
            Confirm Bed Allocation
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<Bed>? beds;
    private List<Patient>? availablePatients;
    private bool isLoading = true;
    private bool showAllocateModal = false;
    private Bed? selectedBed;
    private Guid selectedPatientId = Guid.Empty;

    private readonly DialogOptions dialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        beds = await AdmissionService.GetVolatileBedMapAsync();
        var allPatients = await PatientService.SearchPatientsAsync("");
        availablePatients = allPatients.Where(p => !p.IsCurrentlyAdmitted).ToList();
        isLoading = false;
    }

    private void HandleOpenAllocateModal(Bed bed)
    {
        selectedBed = bed;
        selectedPatientId = Guid.Empty;
        showAllocateModal = true;
    }

    private async Task ConfirmAllocationAsync()
    {
        if (selectedBed != null && selectedPatientId != Guid.Empty)
        {
            await AdmissionService.AllocateBedAsync(selectedBed.Id, selectedPatientId);
            Snackbar.Add($"Bed {selectedBed.BedNumber} allocated successfully!", Severity.Success);
            showAllocateModal = false;
            await LoadDataAsync();
        }
    }

    private async Task HandleDischargeAsync(Bed bed)
    {
        await AdmissionService.DischargePatientFromBedAsync(bed.Id);
        Snackbar.Add($"Patient discharged from Bed {bed.BedNumber}.", Severity.Info);
        await LoadDataAsync();
    }

    private void CloseModal()
    {
        showAllocateModal = false;
    }
}