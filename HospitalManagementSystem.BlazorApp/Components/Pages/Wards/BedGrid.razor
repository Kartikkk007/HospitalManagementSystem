@using HospitalManagementSystem.Core.Domain.Entities

<MudGrid Spacing="3">
    @if (Beds == null || !Beds.Any())
    {
        <MudItem xs="12">
            <MudPaper Class="pa-8 text-center" Elevation="1">
                <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Size="Size.Large" Class="mb-3" />
                <MudText Typo="Typo.h6">No Hospital Beds Configured</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">No active beds are currently registered in this ward context.</MudText>
            </MudPaper>
        </MudItem>
    }
    else
    {
        @foreach (var bed in Beds)
        {
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Elevation="1" Class="rounded-xl h-100 d-flex flex-column justify-space-between border-t-4"
                         Style="@(bed.IsOccupied ? "border-top: 4px solid var(--mud-palette-error);" : "border-top: 4px solid var(--mud-palette-success);")">
                    <MudCardHeader>
                        <CardHeaderAvatar>
                            <MudAvatar Color="@(bed.IsOccupied ? Color.Error : Color.Success)" Variant="Variant.Filled">
                                <MudIcon Icon="@(bed.IsOccupied ? Icons.Material.Filled.Hotel : Icons.Material.Filled.Check)" Size="Size.Small" />
                            </MudAvatar>
                        </CardHeaderAvatar>
                        <CardHeaderContent>
                            <MudText Typo="Typo.subtitle1" Class="fw-bold">Bed @bed.BedNumber</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@bed.WardName</MudText>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudChip T="string" Color="@(bed.IsOccupied ? Color.Error : Color.Success)" Size="Size.Small" Variant="Variant.Filled">
                                @(bed.IsOccupied ? "Occupied" : "Available")
                            </MudChip>
                        </CardHeaderActions>
                    </MudCardHeader>

                    <MudCardContent Class="py-2">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mb-2">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Daily Ward Rate</MudText>
                            <MudText Typo="Typo.body2" Class="fw-bold">₹@bed.DailyRate <span style="font-size: 0.75rem;" class="text-muted">/day</span></MudText>
                        </MudStack>

                        <MudDivider Class="my-2" />

                        @if (bed.IsOccupied && bed.Occupant != null)
                        {
                            <MudPaper Class="pa-2 rounded-lg" Style="background-color: rgba(239, 68, 68, 0.08); border: 1px solid rgba(239, 68, 68, 0.2);" Elevation="0">
                                <MudText Typo="Typo.caption" Color="Color.Error" Class="fw-bold d-block">CURRENT INPATIENT</MudText>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Color="Color.Error" />
                                    <MudText Typo="Typo.body2" Class="fw-semibold">@bed.Occupant.FirstName @bed.Occupant.LastName</MudText>
                                </MudStack>
                            </MudPaper>
                        }
                        else
                        {
                            <MudPaper Class="pa-2 text-center rounded-lg" Style="background-color: rgba(16, 185, 129, 0.08); border: 1px solid rgba(16, 185, 129, 0.2);" Elevation="0">
                                <MudText Typo="Typo.caption" Color="Color.Success" Class="fw-semibold">
                                    <MudIcon Icon="@Icons.Material.Filled.Shield" Size="Size.Small" Class="vertical-align-middle me-1" />
                                    Ready for Admission
                                </MudText>
                            </MudPaper>
                        }
                    </MudCardContent>

                    <MudCardActions Class="pa-3">
                        @if (bed.IsOccupied)
                        {
                            <MudButton FullWidth="true" Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.ExitToApp" OnClick="() => OnDischargeClicked.InvokeAsync(bed)">
                                Discharge Patient
                            </MudButton>
                        }
                        else
                        {
                            <MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.AddCircle" OnClick="() => OnAllocateClicked.InvokeAsync(bed)">
                                Allocate Bed
                            </MudButton>
                        }
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    }
</MudGrid>

@code {
    [Parameter] public List<Bed>? Beds { get; set; }
    [Parameter] public EventCallback<Bed> OnAllocateClicked { get; set; }
    [Parameter] public EventCallback<Bed> OnDischargeClicked { get; set; }
}