@page "/"
@using HospitalManagementSystem.Core.Application.Interfaces
@using HospitalManagementSystem.Core.Domain.Entities
@inject IPatientService PatientService
@inject IAdmissionService AdmissionService
@inject NavigationManager NavigationManager

<PageTitle>Hospital Command Dashboard - AegisCare HMS</PageTitle>

<div class="dashboard-container">
    <!-- Welcome Header Banner -->
    <div class="card-modern p-4 mb-4 bg-gradient-primary text-white border-0 shadow-md position-relative overflow-hidden" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);">
        <div class="position-relative z-1 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
            <div>
                <span class="badge bg-primary bg-opacity-25 text-info px-3 py-2 rounded-pill mb-2 border border-info border-opacity-25">
                    <i class="bi bi-shield-check me-1"></i> Hospital Operations Live Feed
                </span>
                <h2 class="text-white fw-bold mb-1">Executive Clinical Command Center</h2>
                <p class="text-slate-300 mb-0">Overview of active patient admissions, ward bed occupancy, and outpatient clinical queues.</p>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-primary btn-modern-primary d-flex align-items-center gap-2" @onclick='() => NavigationManager.NavigateTo("patients/register")'>
                    <i class="bi bi-person-plus-fill fs-5"></i> New Intake
                </button>
                <button class="btn btn-outline-light btn-modern-outline d-flex align-items-center gap-2 text-white border-slate-700" @onclick='() => NavigationManager.NavigateTo("wards/beds")'>
                    <i class="bi bi-hospital fs-5"></i> Bed Map
                </button>
            </div>
        </div>
    </div>

    <!-- Live Metric Cards Grid -->
    <div class="row g-4 mb-4">
        <!-- Total Patients -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="metric-card">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-secondary small fw-semibold text-uppercase tracking-wider">Total Patients</span>
                        <h3 class="fw-bold mt-1 mb-0">@(patients?.Count ?? 0)</h3>
                    </div>
                    <div class="icon-shape primary">
                        <i class="bi bi-people-fill"></i>
                    </div>
                </div>
                <div class="mt-3 d-flex align-items-center text-muted small">
                    <span class="text-success fw-semibold me-1"><i class="bi bi-arrow-up-right"></i> Active</span> Master Directory
                </div>
            </div>
        </div>

        <!-- Active Inpatients -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="metric-card">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-secondary small fw-semibold text-uppercase tracking-wider">Active Inpatients</span>
                        <h3 class="fw-bold mt-1 mb-0">@(patients?.Count(p => p.IsCurrentlyAdmitted) ?? 0)</h3>
                    </div>
                    <div class="icon-shape danger">
                        <i class="bi bi-hospital"></i>
                    </div>
                </div>
                <div class="mt-3 d-flex align-items-center text-muted small">
                    <span class="badge badge-soft-danger me-2">IPD</span> Currently Admitted
                </div>
            </div>
        </div>

        <!-- Total Beds -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="metric-card">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-secondary small fw-semibold text-uppercase tracking-wider">Total Beds</span>
                        <h3 class="fw-bold mt-1 mb-0">@(beds?.Count ?? 0)</h3>
                    </div>
                    <div class="icon-shape success">
                        <i class="bi bi-grid-3x3-gap-fill"></i>
                    </div>
                </div>
                <div class="mt-3 d-flex align-items-center text-muted small">
                    <span class="text-success fw-semibold me-1">@(beds?.Count(b => !b.IsOccupied) ?? 0) Available</span> for allocation
                </div>
            </div>
        </div>

        <!-- Occupancy Rate -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="metric-card">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-secondary small fw-semibold text-uppercase tracking-wider">Occupancy Rate</span>
                        <h3 class="fw-bold mt-1 mb-0">@(OccupancyRate)%</h3>
                    </div>
                    <div class="icon-shape warning">
                        <i class="bi bi-activity"></i>
                    </div>
                </div>
                <div class="mt-3 d-flex align-items-center text-muted small">
                    <div class="progress flex-grow-1 me-2" style="height: 6px;">
                        <div class="progress-bar bg-warning" role="progressbar" style="width: @(OccupancyRate)%;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Navigation & Wards Status Section -->
    <div class="row g-4">
        <!-- Quick Actions Panel -->
        <div class="col-12 col-lg-7">
            <div class="card-modern p-4 h-100">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h5 class="fw-bold mb-0"><i class="bi bi-lightning-charge-fill text-warning me-2"></i>Clinical Quick Actions</h5>
                </div>
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <div class="p-3 border rounded-3 bg-light hover-shadow transition cursor-pointer" @onclick='() => NavigationManager.NavigateTo("patients/register")'>
                            <div class="d-flex align-items-center gap-3">
                                <div class="icon-shape primary rounded-circle">
                                    <i class="bi bi-person-plus"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-1">Patient Registration</h6>
                                    <span class="small text-muted">Register a new patient into the hospital directory.</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <div class="p-3 border rounded-3 bg-light hover-shadow transition cursor-pointer" @onclick='() => NavigationManager.NavigateTo("wards/beds")'>
                            <div class="d-flex align-items-center gap-3">
                                <div class="icon-shape teal rounded-circle">
                                    <i class="bi bi-door-open"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-1">Ward Bed Map</h6>
                                    <span class="small text-muted">View live bed availability and assign IPD beds.</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <div class="p-3 border rounded-3 bg-light hover-shadow transition cursor-pointer" @onclick='() => NavigationManager.NavigateTo("patients/registry")'>
                            <div class="d-flex align-items-center gap-3">
                                <div class="icon-shape success rounded-circle">
                                    <i class="bi bi-journal-text"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-1">Patient Master File</h6>
                                    <span class="small text-muted">Search and review patient medical histories.</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <div class="p-3 border rounded-3 bg-light hover-shadow transition cursor-pointer" @onclick='() => NavigationManager.NavigateTo("appointments/book")'>
                            <div class="d-flex align-items-center gap-3">
                                <div class="icon-shape warning rounded-circle">
                                    <i class="bi bi-calendar2-check"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-1">OPD Appointments</h6>
                                    <span class="small text-muted">Book consultations with specialist doctors.</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Activity Feed -->
        <div class="col-12 col-lg-5">
            <div class="card-modern p-4 h-100">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h5 class="fw-bold mb-0"><i class="bi bi-clock-history text-primary me-2"></i>Ward Occupancy Feed</h5>
                    <button class="btn btn-sm btn-link text-decoration-none" @onclick="LoadDashboardData">Refresh</button>
                </div>
                
                @if (beds == null)
                {
                    <div class="text-center py-4">
                        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                    </div>
                }
                else if (!beds.Any())
                {
                    <div class="text-muted small text-center py-4">No ward beds registered in system.</div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var bed in beds.Take(4))
                        {
                            <div class="list-group-item px-0 py-3 d-flex align-items-center justify-content-between border-bottom">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="badge rounded-pill @(bed.IsOccupied ? "bg-danger" : "bg-success") p-2">
                                        <i class="bi @(bed.IsOccupied ? "bi-person-fill" : "bi-check-lg")"></i>
                                    </div>
                                    <div>
                                        <div class="fw-semibold">@bed.BedNumber <span class="text-muted small">(@bed.WardName)</span></div>
                                        <span class="small text-muted">
                                            @(bed.IsOccupied && bed.Occupant != null ? $"Patient: {bed.Occupant.FirstName} {bed.Occupant.LastName}" : "Vacant & Ready")
                                        </span>
                                    </div>
                                </div>
                                <span class="badge @(bed.IsOccupied ? "badge-soft-danger" : "badge-soft-success")">
                                    @(bed.IsOccupied ? "Occupied" : "Available")
                                </span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Component-level authorization example -->
    <div class="row g-4 mt-1">
        <div class="col-12">
            <div class="card-modern p-4">
                <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-3">
                    <div>
                        <h5 class="fw-bold mb-1"><i class="bi bi-lock-fill text-primary me-2"></i>Restricted Operations Briefing</h5>
                        <p class="text-muted small mb-0">Protected dashboard content rendered inside the home page.</p>
                    </div>
                    <span class="badge badge-soft-info px-3 py-2">Component Authorization Demo</span>
                </div>

                <AuthorizeView>
                    <Authorized Context="authContext">
                        <div class="row g-3">
                            <div class="col-12 col-md-4">
                                <div class="p-3 border rounded-3 bg-light h-100">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="icon-shape success rounded-circle">
                                            <i class="bi bi-person-check-fill"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold mb-1">Signed In Staff</h6>
                                            <span class="small text-muted">@authContext.User.Identity?.Name can access this protected briefing.</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 col-md-4">
                                <AuthorizeView Roles="Admin,Nurse">
                                    <Authorized>
                                        <div class="p-3 border rounded-3 bg-light h-100 cursor-pointer hover-shadow transition" @onclick='() => NavigationManager.NavigateTo("wards/beds")'>
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="icon-shape danger rounded-circle">
                                                    <i class="bi bi-hospital-fill"></i>
                                                </div>
                                                <div>
                                                    <h6 class="fw-bold mb-1">IPD Ward Control</h6>
                                                    <span class="small text-muted">Admin and nursing staff can open bed allocation controls.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </Authorized>
                                    <NotAuthorized>
                                        <div class="p-3 border rounded-3 bg-light h-100 text-muted small">
                                            <i class="bi bi-shield-lock me-1"></i> Ward controls are visible only to Admin and Nurse roles.
                                        </div>
                                    </NotAuthorized>
                                </AuthorizeView>
                            </div>

                            <div class="col-12 col-md-4">
                                <AuthorizeView Roles="Admin,Doctor">
                                    <Authorized>
                                        <div class="p-3 border rounded-3 bg-light h-100 cursor-pointer hover-shadow transition" @onclick='() => NavigationManager.NavigateTo("doctor/consultation")'>
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="icon-shape primary rounded-circle">
                                                    <i class="bi bi-clipboard2-pulse-fill"></i>
                                                </div>
                                                <div>
                                                    <h6 class="fw-bold mb-1">Doctor Console</h6>
                                                    <span class="small text-muted">Doctors can jump straight into consultation workflow.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </Authorized>
                                    <NotAuthorized>
                                        <div class="p-3 border rounded-3 bg-light h-100 text-muted small">
                                            <i class="bi bi-shield-lock me-1"></i> Consultation tools are visible only to Admin and Doctor roles.
                                        </div>
                                    </NotAuthorized>
                                </AuthorizeView>
                            </div>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <div class="p-4 border rounded-3 bg-light d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                            <div>
                                <h6 class="fw-bold mb-1">Protected Staff Briefing Locked</h6>
                                <p class="text-muted small mb-0">Sign in to view role-based operational content inside this same dashboard page.</p>
                            </div>
                            <button class="btn btn-modern-primary d-flex align-items-center gap-2" @onclick="NavigateToLogin">
                                <i class="bi bi-box-arrow-in-right"></i> Sign In to View
                            </button>
                        </div>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Patient>? patients;
    private List<Bed>? beds;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardData();
    }

    private async Task LoadDashboardData()
    {
        patients = await PatientService.SearchPatientsAsync("");
        beds = await AdmissionService.GetVolatileBedMapAsync();
    }

    private int OccupancyRate
    {
        get
        {
            if (beds == null || !beds.Any()) return 0;
            var occupied = beds.Count(b => b.IsOccupied);
            return (int)Math.Round((double)occupied / beds.Count * 100);
        }
    }

    private void NavigateToLogin()
    {
        NavigationManager.NavigateTo("Account/Login");
    }
}
